<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_top_task_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_rounded_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_top_task_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tarea Inmediata"
        android:textColor="#666666"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_top_task_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:text="No hay tareas pendientes"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_top_task_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#888888"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/widget_top_task_complete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_circle_bg"
            android:src="@android:drawable/checkbox_on_background"
            android:tint="#FFFFFF"
            android:padding="8dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>

